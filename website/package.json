{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-installers.mjs && farm dev",
    "build": "node scripts/copy-installers.mjs && farm build",
    "build:node": "node scripts/copy-installers.mjs && farm build --preset node-server",
    "start": "node .farm/.output/server/index.mjs",
    "preview": "node scripts/copy-installers.mjs && farm build --preset node-server && node .farm/.output/server/index.mjs",
    "deploy": "farm deploy --vercel",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@farm.js/core": "0.1.63",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@farm.js/cli": "0.1.63",
    "@farm.js/devtools": "0.1.63",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.28.0"
}
