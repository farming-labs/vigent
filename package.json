{
  "name": "@vigent/cli",
  "version": "0.9.4",
  "description": "A vim-native orchestrator for coding-agent harnesses: Claude Code, Codex, OpenCode, Gemini CLI, Cursor CLI and pi side by side, each in its own lightweight git worktree.",
  "keywords": [
    "vim",
    "neovim",
    "tui",
    "terminal",
    "coding-agent",
    "ai",
    "agents",
    "git-worktree",
    "pi",
    "llm",
    "cli"
  ],
  "homepage": "https://vigent.farming-labs.dev",
  "bugs": {
    "url": "https://github.com/farming-labs/vigent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/vigent.git"
  },
  "license": "MIT",
  "author": "KinfeMichael Tariku",
  "type": "module",
  "bin": {
    "vigent": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && node -e \"require('fs').cpSync('src/vendor', 'dist/vendor', { recursive: true, filter: (f) => !f.endsWith('.d.ts') })\"",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "demo": "node dist/cli.js --demo",
    "test": "tsc && node --test test/*.test.mjs",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "get-east-asian-width": "^1.7.0",
    "riftri": "^0.6.7",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@types/node": "^26.6.6",
    "@xterm/headless": "^5.5.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
